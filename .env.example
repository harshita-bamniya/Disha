# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=disha
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=disha_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: Generate strong secrets with: openssl rand -hex 32
# App will refuse to start in production with default values.
JWT_SECRET_KEY=change_me_in_production_minimum_32_chars
JWT_REFRESH_SECRET_KEY=change_me_in_production_minimum_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://disha.app,https://www.disha.app

# ── AI Providers ──────────────────────────────────────────────────────────────
# At least one AI key required in production
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── SMS (MSG91) ───────────────────────────────────────────────────────────────
# Required in production for OTP delivery. OTPs are printed to console in local mode.
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=DISHA

# ── Monitoring (Sentry) ───────────────────────────────────────────────────────
# Optional but strongly recommended for production
SENTRY_DSN=

# ── App ───────────────────────────────────────────────────────────────────────
# Values: local | development | staging | production
ENVIRONMENT=local
LOG_LEVEL=DEBUG

# ── Database pool (optional overrides) ───────────────────────────────────────
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
